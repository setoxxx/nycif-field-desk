{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nycif:gv2:v2/enigma-core",
  "title": "V2 Enigma Core fixture",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0-fixture"
    },
    "fixture": {
      "const": true
    },
    "operational": {
      "const": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?!.*(?:\\$\\(|\\$\\{|`|<script|javascript:))[^<>]*$",
            "maxLength": 4000
          },
          "status": {
            "type": "string",
            "enum": [
              "COMPLETE",
              "IN_PROGRESS",
              "NOT_STARTED",
              "NOT_AUTHORIZED",
              "LOCKED",
              "PLANNED"
            ]
          },
          "detail": {
            "type": "string",
            "pattern": "^(?!.*(?:\\$\\(|\\$\\{|`|<script|javascript:))[^<>]*$",
            "maxLength": 4000
          }
        },
        "required": [
          "name",
          "status",
          "detail"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "fixture",
    "operational",
    "components"
  ]
}
